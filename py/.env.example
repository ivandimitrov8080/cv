# Copy to ../.env (the repo's .envrc sources it). Everything is optional except
# DEEPSEEK_API_KEY.

DEEPSEEK_API_KEY=
ITEMPIPE_DB=/home/ivand/src/cv/py/itempipe.db
ITEMPIPE_MODEL=deepseek-chat
ITEMPIPE_BASE_URL=https://api.deepseek.com/v1

# What to look for lives in a TOML file, not in the code. Defaults to itempipe/search.toml;
# point this elsewhere to hunt for something else (a second file, a different role).
# ITEMPIPE_CONFIG=/home/ivand/src/cv/py/itempipe/search.toml

# The user's own answers to application questions, as org headings with an :ANSWER:
# property. `apply` reads it, and writes to it the questions it cannot answer; a lead held
# on one comes back to the queue once the :ANSWER: is filled in.
# ITEMPIPE_QUESTIONS=/home/ivand/src/cv/application-questions.org

# `search` runs until Ctrl-C. ITEMPIPE_SESSIONS=0 (default) means no per-worker cap.
# ITEMPIPE_SESSIONS=6
# ITEMPIPE_SESSION_STEPS=26
# ITEMPIPE_TOOL_BUDGET=12
# ITEMPIPE_BOARD_SEEDS=2
# ITEMPIPE_PAUSE=2
# ITEMPIPE_IDLE=300
# ITEMPIPE_SEEN_DAYS=365
# ITEMPIPE_BOARD_DAYS=3
# ITEMPIPE_QUERY_DAYS=30

# `apply` starts a headed Chromium by default; only set this where there is no display.
# Chromium's headless mode refuses more than one target at startup.
# ITEMPIPE_HEADLESS=1
# ITEMPIPE_CDP_PORT=9222
# ITEMPIPE_PROFILE=/tmp/itempipe-chromium

# playwright-mcp speaks MCP over stdio to `apply`; its own stderr goes to a log rather than
# over the progress board, and each tool result is capped so a snapshot cannot flood the
# model's context.
# ITEMPIPE_MCP_LOG=/tmp/itempipe-mcp-9222.log
# ITEMPIPE_MCP_OUTPUT=20000
