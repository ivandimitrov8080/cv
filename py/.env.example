# Copy to .env (the repo's .envrc sources it) and fill in.
# Every value here is optional except DEEPSEEK_API_KEY if you run `itempipe run`.

# --- model -------------------------------------------------------------------
DEEPSEEK_API_KEY=
ITEMPIPE_MODEL=deepseek-chat
ITEMPIPE_BASE_URL=https://api.deepseek.com/v1

# --- storage -----------------------------------------------------------------
# One file, WAL, shared by every worker on this machine.
ITEMPIPE_DB=/home/ivand/src/cv/py/itempipe.db

# --- concurrency -------------------------------------------------------------
ITEMPIPE_MAX_SEARCH_WORKERS=4
ITEMPIPE_MAX_APPLY_WORKERS=2
ITEMPIPE_BROWSER_SLOTS=2
ITEMPIPE_MAX_LLM_CONCURRENCY=6
ITEMPIPE_CLAIM_LEASE_SECONDS=900
ITEMPIPE_HEARTBEAT_SECONDS=30
ITEMPIPE_EMAIL_MIN_INTERVAL=5.0

# --- email -------------------------------------------------------------------
# Default transport is `msmtp -t` (same path sendmail-send-it used). Only set
# ITEMPIPE_SMTP_HOST to switch to a direct SMTP_SSL connection.
ITEMPIPE_MSMTP_ACCOUNT=default
# ITEMPIPE_SMTP_HOST=smtp.example.com
# ITEMPIPE_SMTP_PORT=465
ITEMPIPE_EMAIL_TEMPLATE=/home/ivand/src/cv/application-email-template.txt
# Colon-separated; defaults to result/Ivan_Dimitrov_Resume_IT_Consultant.pdf
# ITEMPIPE_ATTACHMENTS=/home/ivand/src/cv/result/Ivan_Dimitrov_Resume_IT_Consultant.pdf:/home/ivand/src/cv/result/Ivan_Dimitrov_Resume_IT_Consultant_ATS.pdf

# --- browser -----------------------------------------------------------------
# One profile directory per worker; two MCP servers sharing one dir fail.
ITEMPIPE_PROFILE_DIR=/home/ivand/src/cv/py/.playwright-profiles
ITEMPIPE_CHROMIUM=/home/ivand/src/cv/.devenv/profile/bin/chromium-sandboxed

# --- misc --------------------------------------------------------------------
ITEMPIPE_ANSWERS_LIMIT=3
ITEMPIPE_FOLLOW_UP_DAYS=14
