# Copy to ../.env (the repo's .envrc sources it). Everything is optional except
# DEEPSEEK_API_KEY.

DEEPSEEK_API_KEY=
ITEMPIPE_DB=/home/ivand/src/cv/py/itempipe.db
ITEMPIPE_MODEL=deepseek-chat
ITEMPIPE_BASE_URL=https://api.deepseek.com/v1

# `search` runs until Ctrl-C. ITEMPIPE_SESSIONS=0 (default) means no per-worker cap.
# ITEMPIPE_SESSIONS=6
# ITEMPIPE_SESSION_STEPS=26
# ITEMPIPE_TOOL_BUDGET=12
# ITEMPIPE_BOARD_SEEDS=2
# ITEMPIPE_PAUSE=2
# ITEMPIPE_IDLE=300
# ITEMPIPE_SEEN_DAYS=365
# ITEMPIPE_BOARD_DAYS=3

# Extra boards without touching the code: {"angle name": ["url", ...]}. Unknown angle
# names join the rotation, so this is how LinkedIn or a regional board gets added.
# ITEMPIPE_BOARDS=~/src/cv/py/boards.json

# This month's "Ask HN: Who is hiring?" item id, so the HN angle starts from the live thread.
# ITEMPIPE_HN_THREAD=49922569
